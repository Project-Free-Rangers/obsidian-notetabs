  },
  "license": "MIT",
  "author": "Jheanell Elliott (Project Free Rangers)",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:gulp": "gulp devwatch",
