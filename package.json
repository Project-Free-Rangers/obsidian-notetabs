    "globals": "14.0.0",
    "gulp": "^5.0.1",
    "jiti": "2.6.1",
    "stylelint": "^16.26.1",
    "tslib": "2.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.35.1"
  },
  "dependencies": {
    "obsidian": "^1.13.1"
  }
