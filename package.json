{
  "name": "notetabs",
  "version": "1.1.1",
  "description": "Create tabbed sections within your notes.",
  "private": true,
  "homepage": "https://github.com/Project-Free-Rangers/obsidian-notetabs#readme",
  "bugs": {
    "url": "https://github.com/Project-Free-Rangers/obsidian-notetabs/issues"
  },
  "repository": {
    "type": "git",
