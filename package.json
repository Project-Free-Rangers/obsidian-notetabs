{
  "name": "obsidian-note-tabs",
  "version": "1.0.0",
  "description": "Create HTML-styled tabbed sections within your Obsidian notes.",
  "homepage": "https://github.com/Project-Free-Rangers/obsidian-note-tabs-private#readme",
  "bugs": {
    "url": "https://github.com/Project-Free-Rangers/obsidian-note-tabs-private/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Project-Free-Rangers/obsidian-note-tabs-private.git"
  },
  "license": "MIT",
  "author": "Project Free Rangers (jaemega)",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "stylelint": "^16.26.1",
    "@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"@eslint/js": "9.30.1",
		"jiti": "2.6.1"
  },
  "dependencies": {
    "obsidian": "latest"
  }
}
